---
import Brand from "./Brand.astro";
import { NAV, SITE } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const year = new Date().getFullYear();

const columns = [
    {
        title: "Product",
        links: [
            { label: "Features", href: `${base}/features/` },
            { label: "Jiggler patterns", href: `${base}/jiggler-patterns/` },
            { label: "How it works", href: `${base}/bluetooth-hid/` },
            { label: "Download the app", href: `${base}/download/` },
        ],
    },
    {
        title: "Support",
        links: [
            { label: "FAQ", href: `${base}/faq/` },
            { label: "Changelog", href: `${base}/changelog/` },
            { label: "Press kit", href: `${base}/press/` },
            { label: `Email ${SITE.developer}`, href: `mailto:${SITE.email}` },
        ],
    },
    {
        title: "Legal",
        links: [
            { label: "Privacy policy", href: `${base}/privacy/` },
            { label: "Terms of service", href: `${base}/terms/` },
        ],
    },
];
---

<footer class="site-footer">
    <div class="container site-footer__inner">
        <div class="site-footer__about">
            <div class="site-footer__brand">
                <Brand size={38} class="site-footer__mark" />
                <span class="site-footer__name">{SITE.name}</span>
            </div>
            <p class="site-footer__tagline">
                Turn an Android phone into a Bluetooth mouse, keyboard and automated
                mouse jiggler. No software on your computer, no internet access, no
                tracking.
            </p>
            <div class="btn-row site-footer__actions">
                <a
                    class="btn btn--primary btn--sm"
                    href={SITE.playUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Get it on Google Play
                </a>
                <a
                    class="btn btn--ghost btn--sm"
                    href={SITE.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    <svg
                        viewBox="0 0 24 24"
                        width="16"
                        height="16"
                        fill="currentColor"
                        aria-hidden="true"
                    >
                        <path
                            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.1.79-.25.79-.56 0-.28-.01-1.02-.02-2-3.2.7-3.88-1.54-3.88-1.54-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.18 1.18a11 11 0 0 1 5.79 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.12 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.27 5.68.41.36.78 1.06.78 2.14 0 1.55-.01 2.8-.01 3.18 0 .31.21.67.8.56A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5z"
                        ></path>
                    </svg>
                    Source code
                </a>
            </div>
        </div>

        <nav class="site-footer__nav" aria-label="Footer">
            {
                columns.map((column) => (
                    <div class="site-footer__col">
                        <h2 class="site-footer__heading">{column.title}</h2>
                        <ul>
                            {column.links.map((link) => (
                                <li>
                                    <a href={link.href}>{link.label}</a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </nav>
    </div>

    <div class="container site-footer__bottom">
        <p>&copy; {year} {SITE.developerName}. {SITE.name} is free and open source.</p>
        <p class="site-footer__meta">
            Version {SITE.version} · Requires {SITE.minSdk} · No internet permission
        </p>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: clamp(3rem, 2rem + 4vw, 6rem);
        border-top: 1px solid var(--line);
        background: var(--surface);
    }

    .site-footer__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        padding-block: clamp(2.5rem, 2rem + 2vw, 3.5rem);
    }

    .site-footer__brand {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 0.9rem;
    }

    .site-footer__mark {
        border-radius: 10px;
        flex: none;
    }

    .site-footer__name {
        font-weight: 700;
        letter-spacing: -0.015em;
    }

    .site-footer__tagline {
        color: var(--ink-2);
        font-size: 0.92rem;
        max-width: 46ch;
    }

    .site-footer__actions {
        margin-top: 1.25rem;
    }

    .btn--sm {
        padding: 0.55rem 0.95rem;
        font-size: 0.86rem;
    }

    .site-footer__nav {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
        gap: 2rem;
    }

    .site-footer__heading {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--ink-3);
        margin-bottom: 0.9rem;
    }

    .site-footer__col ul {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
    }

    .site-footer__col a {
        color: var(--ink-2);
        text-decoration: none;
        font-size: 0.9rem;
    }

    .site-footer__col a:hover {
        color: var(--brand);
        text-decoration: underline;
    }

    .site-footer__bottom {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem 1.5rem;
        justify-content: space-between;
        padding-block: 1.25rem;
        border-top: 1px solid var(--line);
        font-size: 0.83rem;
        color: var(--ink-3);
    }

    @media (min-width: 52rem) {
        .site-footer__inner {
            grid-template-columns: minmax(0, 1.4fr) minmax(0, 1.6fr);
            gap: 3.5rem;
        }
    }
</style>
