---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE } from "../data/site";

interface Props {
    title: string;
    description: string;
    /** Overrides the generated canonical URL. */
    canonical?: string;
    /** Path (relative to the site base) of the social share image. */
    ogImage?: string;
    /** JSON-LD objects appended to the page's structured data graph. */
    schema?: Record<string, unknown>[];
    /** Suffix appended to the title, e.g. "Features". */
    titleSuffix?: string;
}

const {
    title,
    description,
    canonical,
    ogImage = "og-image.png",
    schema = [],
    titleSuffix = "",
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const siteUrl = Astro.site ?? new URL(SITE.url);

/**
 * Search Console verification token. Set PUBLIC_GOOGLE_SITE_VERIFICATION in
 * the build environment (or .env) to emit the verification meta tag.
 */
const googleVerification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;

/** Absolute, https-only canonical URL for this page. */
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).href;
const ogImageUrl = new URL(`${base}/${ogImage}`, siteUrl).href;

const fullTitle = titleSuffix ? `${title} · ${SITE.name}` : title;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />

        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta
            name="robots"
            content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
        />
        <meta name="application-name" content={SITE.name} />
        <meta name="apple-mobile-web-app-title" content={SITE.name} />
        <meta name="author" content={SITE.developerName} />
        <meta name="theme-color" content="#3f19bc" media="(prefers-color-scheme: light)" />
        <meta name="theme-color" content="#0c0918" media="(prefers-color-scheme: dark)" />

        <!-- Canonical -->
        <link rel="canonical" href={canonicalUrl} />

        <!-- Search Console / Bing verification -->
        {
            googleVerification && (
                <meta
                    name="google-site-verification"
                    content={googleVerification}
                />
            )
        }

        <!-- Icons / manifest -->
        <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
        <link rel="icon" type="image/png" sizes="32x32" href={`${base}/favicon-32.png`} />
        <link rel="apple-touch-icon" sizes="180x180" href={`${base}/apple-touch-icon.png`} />
        <link rel="manifest" href={`${base}/site.webmanifest`} />

        <!-- Open Graph -->
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:locale" content={SITE.locale} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImageUrl} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={`${SITE.name} app icon and wordmark`} />

        <!-- Twitter -->
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={fullTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImageUrl} />
        <meta name="twitter:image:alt" content={`${SITE.name} app icon and wordmark`} />

        <!-- Resolve the theme before first paint so there is no flash of the
             wrong colour scheme and no layout shift. -->
        <script is:inline>
            (function () {
                try {
                    var stored = localStorage.getItem("rmj-theme");
                    var pref =
                        stored === "light" || stored === "dark" || stored === "system"
                            ? stored
                            : "system";
                    var resolved =
                        pref === "system"
                            ? window.matchMedia("(prefers-color-scheme: dark)").matches
                                ? "dark"
                                : "light"
                            : pref;
                    document.documentElement.setAttribute("data-theme-pref", pref);
                    document.documentElement.dataset.theme = resolved;
                } catch (e) {
                    document.documentElement.dataset.theme = "light";
                }
            })();
        </script>

        {
            schema.length > 0 && (
                <script
                    type="application/ld+json"
                    is:inline
                    set:html={JSON.stringify(
                        schema.length === 1 ? schema[0] : { "@context": "https://schema.org", "@graph": schema },
                    )}
                />
            )
        }
    </head>

    <body>
        <a class="skip-link" href="#main">Skip to content</a>

        <Header />

        <main id="main">
            <slot />
        </main>

        <Footer />
    </body>
</html>
