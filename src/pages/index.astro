---
import Layout from "../layouts/Layout.astro";
import { translations } from "../data/translations";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout
    title="Remote Mouse Jiggler | Bluetooth HID Mouse, Keyboard & Jiggler for Android"
    description="Transform your phone into a Bluetooth wireless trackpad, air mouse, presentation controller, TV remote, and automated mouse jiggler. Zero desktop software required."
>
    <!-- HERO SECTION -->
    <section class="hero-section">
        <div class="container hero-container">
            <div class="hero-icon-wrapper">
                <div class="glow-ring"></div>
                <img
                    src={`${base}/remote-mouse-jiggler-logo.png`}
                    alt="Remote Mouse Jiggler Logo"
                    class="hero-app-icon"
                    width="128"
                    height="128"
                />
            </div>

            <h1 class="hero-title" id="hero-title">
                Remote <span class="gradient-text">Mouse Jiggler</span>
            </h1>
            <p class="hero-tagline">{translations.tagline}</p>
            <p class="hero-description">{translations.description}</p>

            <div class="hero-actions">
                <a
                    href="https://play.google.com/store/apps/details?id=com.heymeowcat.remotemousejiggler"
                    class="play-badge-link"
                    target="_blank"
                    rel="noopener noreferrer"
                    id="btn-play-store"
                >
                    <img
                        src={`${base}/google-play-badge.svg`}
                        alt="Get it on Google Play"
                        class="play-badge-img"
                        height="64"
                    />
                </a>

                <a
                    href="https://github.com/heymeowcat/RemoteMouseJiggler"
                    class="btn-secondary-action"
                    target="_blank"
                    rel="noopener noreferrer"
                    id="btn-github"
                >
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor">
                        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                    <span>{translations.viewOnGithub}</span>
                </a>
            </div>

            <!-- Stats Highlights (3 items) -->
            <div class="highlights-grid">
                <div class="highlight-item">
                    <div class="highlight-num">0</div>
                    <div class="highlight-title">{translations.highlights.zeroSoftware}</div>
                    <div class="highlight-desc">{translations.highlights.zeroSoftwareDesc}</div>
                </div>
                <div class="highlight-item">
                    <div class="highlight-num">7</div>
                    <div class="highlight-title">{translations.highlights.patterns}</div>
                    <div class="highlight-desc">{translations.highlights.patternsDesc}</div>
                </div>
                <div class="highlight-item">
                    <div class="highlight-num">100%</div>
                    <div class="highlight-title">{translations.highlights.offline}</div>
                    <div class="highlight-desc">{translations.highlights.offlineDesc}</div>
                </div>
            </div>
        </div>
    </section>

    <!-- INTERACTIVE JIGGLER SIMULATOR -->
    <section id="interactive-demo" class="demo-section">
        <div class="container">
            <div class="section-header">
                <span class="section-pill">{translations.jigglerDemo.badge}</span>
                <h2 class="section-title">{translations.jigglerDemo.title}</h2>
                <p class="section-subtitle">{translations.jigglerDemo.subtitle}</p>
            </div>

            <div class="simulator-card">
                <div class="simulator-visualizer">
                    <canvas id="jigglerCanvas" width="460" height="340"></canvas>
                    <div class="simulator-hud">
                        <div class="hud-status" id="hudStatus">
                            <span class="hud-dot pulsing"></span>
                            <span id="hudStateText">JIGGLER ACTIVE</span>
                        </div>
                        <div class="hud-metrics">
                            <span id="hudPatternName">Micro Jitter</span>
                            <span class="hud-separator">•</span>
                            <span id="hudStatsText">Moves: 0 | Time: 00:00:00</span>
                        </div>
                    </div>
                </div>

                <div class="simulator-controls">
                    <div class="control-group">
                        <label class="control-label">Select Movement Algorithm</label>
                        <div class="pattern-selector" id="patternButtons">
                            <button class="pattern-btn active" data-pattern="jitter">
                                <strong>Micro Jitter</strong>
                                <span>Subtle 1px micro-vibrations</span>
                            </button>
                            <button class="pattern-btn" data-pattern="circle">
                                <strong>Smooth Circle</strong>
                                <span>Circular rotation loop</span>
                            </button>
                            <button class="pattern-btn" data-pattern="figureEight">
                                <strong>Figure Eight</strong>
                                <span>Fluid infinity pattern</span>
                            </button>
                            <button class="pattern-btn" data-pattern="random">
                                <strong>Random Wander</strong>
                                <span>Organic unpredictable roaming</span>
                            </button>
                            <button class="pattern-btn" data-pattern="wave">
                                <strong>Sine Wave</strong>
                                <span>Sinusoidal wave oscillation</span>
                            </button>
                            <button class="pattern-btn" data-pattern="spiral">
                                <strong>Expanding Spiral</strong>
                                <span>Concentric expanding spiral</span>
                            </button>
                            <button class="pattern-btn" data-pattern="diagonal">
                                <strong>Diagonal Bounce</strong>
                                <span>Corner-to-corner trajectory</span>
                            </button>
                        </div>
                    </div>

                    <div class="pattern-info-box" id="patternDescription">
                        {translations.patterns.jitter.desc}
                    </div>

                    <div class="simulator-actions">
                        <button id="btnToggleJiggle" class="btn-toggle-jiggle">
                            <svg id="iconPlayPause" viewBox="0 0 24 24" width="18" height="18" fill="currentColor">
                                <path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/>
                            </svg>
                            <span id="btnToggleText">Pause Jiggler</span>
                        </button>
                        <button id="btnResetJiggle" class="btn-reset-jiggle">Reset Counter</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- CORE FEATURES SECTION -->
    <section id="features" class="features-section">
        <div class="container">
            <div class="section-header">
                <span class="section-pill">Capabilities</span>
                <h2 class="section-title">{translations.features.sectionTitle}</h2>
                <p class="section-subtitle">{translations.features.sectionSubtitle}</p>
            </div>

            <div class="features-grid">
                <!-- Feature 1: Jiggler -->
                <div class="feature-card highlighted-card">
                    <div class="feature-icon-box">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 2v4m0 12v4M4.93 4.93l2.83 2.83m8.48 8.48l2.83 2.83M2 12h4m12 0h4M4.93 19.07l2.83-2.83m8.48-8.48l2.83-2.83"/>
                            <circle cx="12" cy="12" r="4"/>
                        </svg>
                    </div>
                    <h3>{translations.features.jiggler.title}</h3>
                    <p>{translations.features.jiggler.desc}</p>
                    <div class="feature-tags">
                        <span>7 Patterns</span>
                        <span>Auto-Timer</span>
                        <span>Background Service</span>
                    </div>
                </div>

                <!-- Feature 2: Mouse & Touchpad -->
                <div class="feature-card">
                    <div class="feature-icon-box">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="5" y="2" width="14" height="20" rx="7"/>
                            <path d="M12 6v4"/>
                        </svg>
                    </div>
                    <h3>{translations.features.mouse.title}</h3>
                    <p>{translations.features.mouse.desc}</p>
                    <div class="feature-tags">
                        <span>Air Mouse Gyro</span>
                        <span>Two-Finger Scroll</span>
                        <span>Click Haptics</span>
                    </div>
                </div>



                <!-- Feature 5: Keyboard -->
                <div class="feature-card">
                    <div class="feature-icon-box">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
                            <rect x="2" y="4" width="20" height="16" rx="2"/>
                            <line x1="6" y1="8" x2="6" y2="8"/>
                            <line x1="10" y1="8" x2="10" y2="8"/>
                            <line x1="14" y1="8" x2="14" y2="8"/>
                            <line x1="18" y1="8" x2="18" y2="8"/>
                            <line x1="6" y1="12" x2="6" y2="12"/>
                            <line x1="10" y1="12" x2="10" y2="12"/>
                            <line x1="14" y1="12" x2="14" y2="12"/>
                            <line x1="18" y1="12" x2="18" y2="12"/>
                            <line x1="7" y1="16" x2="17" y2="16"/>
                        </svg>
                    </div>
                    <h3>{translations.features.keyboard.title}</h3>
                    <p>{translations.features.keyboard.desc}</p>
                    <div class="feature-tags">
                        <span>International Layouts</span>
                        <span>Modifier Keys</span>
                        <span>Text Dispatch</span>
                    </div>
                </div>

                <!-- Feature 6: Privacy & Offline -->
                <div class="feature-card">
                    <div class="feature-icon-box">
                        <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                    </div>
                    <h3>{translations.features.privacy.title}</h3>
                    <p>{translations.features.privacy.desc}</p>
                    <div class="feature-tags">
                        <span>No Internet Needed</span>
                        <span>Zero Data Collection</span>
                        <span>Pure Bluetooth HID</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- HOW IT WORKS SECTION -->
    <section id="how-it-works" class="how-section">
        <div class="container">
            <div class="section-header">
                <span class="section-pill">Setup</span>
                <h2 class="section-title">{translations.howItWorks.title}</h2>
                <p class="section-subtitle">{translations.howItWorks.subtitle}</p>
            </div>

            <div class="steps-grid">
                <div class="step-card">
                    <div class="step-number">1</div>
                    <h3>{translations.howItWorks.step1Title}</h3>
                    <p>{translations.howItWorks.step1Desc}</p>
                </div>
                <div class="step-card">
                    <div class="step-number">2</div>
                    <h3>{translations.howItWorks.step2Title}</h3>
                    <p>{translations.howItWorks.step2Desc}</p>
                </div>
                <div class="step-card">
                    <div class="step-number">3</div>
                    <h3>{translations.howItWorks.step3Title}</h3>
                    <p>{translations.howItWorks.step3Desc}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ SECTION -->
    <section id="faq" class="faq-section">
        <div class="container">
            <div class="section-header">
                <span class="section-pill">Questions</span>
                <h2 class="section-title">{translations.faq.title}</h2>
            </div>

            <div class="faq-grid">
                <div class="faq-item">
                    <h4>{translations.faq.q1}</h4>
                    <p>{translations.faq.a1}</p>
                </div>
                <div class="faq-item">
                    <h4>{translations.faq.q2}</h4>
                    <p>{translations.faq.a2}</p>
                </div>
                <div class="faq-item">
                    <h4>{translations.faq.q3}</h4>
                    <p>{translations.faq.a3}</p>
                </div>
                <div class="faq-item">
                    <h4>{translations.faq.q4}</h4>
                    <p>{translations.faq.a4}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- CLIENT SCRIPT FOR INTERACTIVE JIGGLER SIMULATION -->
    <script define:vars={{ patterns: translations.patterns }}>
        const canvas = document.getElementById("jigglerCanvas");
        const ctx = canvas.getContext("2d");
        const hudPatternName = document.getElementById("hudPatternName");
        const hudStatsText = document.getElementById("hudStatsText");
        const hudStateText = document.getElementById("hudStateText");
        const hudDot = document.querySelector(".hud-dot");
        const btnToggleJiggle = document.getElementById("btnToggleJiggle");
        const btnToggleText = document.getElementById("btnToggleText");
        const btnResetJiggle = document.getElementById("btnResetJiggle");
        const patternButtons = document.querySelectorAll(".pattern-btn");
        const patternDescription = document.getElementById("patternDescription");

        let activePattern = "jitter";
        let isRunning = true;
        let totalMoves = 0;
        let startTime = Date.now();
        let elapsedSeconds = 0;

        let curX = canvas.width / 2;
        let curY = canvas.height / 2;
        let originX = canvas.width / 2;
        let originY = canvas.height / 2;

        let stepAngle = 0.0;
        let moveDirection = 1;
        let spiralRadius = 1.0;
        let trail = [];
        const maxTrail = 80;

        function updatePatternDescription() {
            if (patterns && patterns[activePattern]) {
                patternDescription.innerText = patterns[activePattern].desc;
                hudPatternName.innerText = patterns[activePattern].name;
            }
        }

        patternButtons.forEach((btn) => {
            btn.addEventListener("click", () => {
                patternButtons.forEach((b) => b.classList.remove("active"));
                btn.classList.add("active");
                activePattern = btn.getAttribute("data-pattern");
                stepAngle = 0.0;
                moveDirection = 1;
                spiralRadius = 1.0;
                trail = [];
                curX = originX;
                curY = originY;
                updatePatternDescription();
            });
        });

        btnToggleJiggle.addEventListener("click", () => {
            isRunning = !isRunning;
            if (isRunning) {
                hudStateText.innerText = "JIGGLER ACTIVE";
                btnToggleText.innerText = "Pause Jiggler";
                hudDot.classList.add("pulsing");
            } else {
                hudStateText.innerText = "JIGGLER PAUSED";
                btnToggleText.innerText = "Resume Jiggler";
                hudDot.classList.remove("pulsing");
            }
        });

        btnResetJiggle.addEventListener("click", () => {
            totalMoves = 0;
            startTime = Date.now();
            elapsedSeconds = 0;
            trail = [];
            curX = originX;
            curY = originY;
        });

        function calculateNextPosition() {
            const r = 50; // visual radius scale
            let dx = 0;
            let dy = 0;

            switch (activePattern) {
                case "jitter":
                    moveDirection = -moveDirection;
                    dx = 12 * moveDirection;
                    dy = (Math.random() - 0.5) * 4;
                    curX = originX + dx;
                    curY = originY + dy;
                    break;
                case "circle":
                    stepAngle += 0.08;
                    if (stepAngle > 2 * Math.PI) stepAngle -= 2 * Math.PI;
                    curX = originX + r * Math.cos(stepAngle);
                    curY = originY + r * Math.sin(stepAngle);
                    break;
                case "figureEight":
                    stepAngle += 0.06;
                    if (stepAngle > 2 * Math.PI) stepAngle -= 2 * Math.PI;
                    curX = originX + r * 1.2 * Math.sin(stepAngle);
                    curY = originY + r * 0.7 * Math.sin(2 * stepAngle);
                    break;
                case "random":
                    curX += (Math.random() - 0.5) * 20;
                    curY += (Math.random() - 0.5) * 20;
                    if (Math.abs(curX - originX) > r * 1.3) curX = originX;
                    if (Math.abs(curY - originY) > r * 1.3) curY = originY;
                    break;
                case "wave":
                    stepAngle += 0.07;
                    if (stepAngle > 2 * Math.PI) stepAngle -= 2 * Math.PI;
                    curX = originX + (stepAngle / (2 * Math.PI) - 0.5) * r * 2.5;
                    curY = originY + Math.sin(stepAngle * 2) * (r * 0.6);
                    break;
                case "spiral":
                    stepAngle += 0.1;
                    if (stepAngle > 2 * Math.PI) stepAngle -= 2 * Math.PI;
                    spiralRadius += 0.4;
                    if (spiralRadius > r) spiralRadius = 2.0;
                    curX = originX + spiralRadius * Math.cos(stepAngle);
                    curY = originY + spiralRadius * Math.sin(stepAngle);
                    break;
                case "diagonal":
                    stepAngle += 0.05;
                    if (stepAngle > 2 * Math.PI) stepAngle -= 2 * Math.PI;
                    const dOffset = Math.sin(stepAngle) * r;
                    curX = originX + dOffset;
                    curY = originY + dOffset;
                    break;
            }

            trail.push({ x: curX, y: curY });
            if (trail.length > maxTrail) {
                trail.shift();
            }
            totalMoves++;
        }

        let lastMoveTick = 0;
        function renderLoop(time) {
            if (isRunning && time - lastMoveTick > 40) {
                calculateNextPosition();
                lastMoveTick = time;
                elapsedSeconds = Math.floor((Date.now() - startTime) / 1000);
            }

            const hrs = String(Math.floor(elapsedSeconds / 3600)).padStart(2, "0");
            const mins = String(Math.floor((elapsedSeconds % 3600) / 60)).padStart(2, "0");
            const secs = String(elapsedSeconds % 60).padStart(2, "0");
            hudStatsText.innerText = `Moves: ${totalMoves} | Time: ${hrs}:${mins}:${secs}`;

            // Draw Background Grid
            ctx.fillStyle = "#0e101a";
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Subtle Grid Lines
            ctx.strokeStyle = "rgba(255, 255, 255, 0.04)";
            ctx.lineWidth = 1;
            const gridSize = 24;
            for (let x = 0; x < canvas.width; x += gridSize) {
                ctx.beginPath();
                ctx.moveTo(x, 0);
                ctx.lineTo(x, canvas.height);
                ctx.stroke();
            }
            for (let y = 0; y < canvas.height; y += gridSize) {
                ctx.beginPath();
                ctx.moveTo(0, y);
                ctx.lineTo(canvas.width, y);
                ctx.stroke();
            }

            // Draw Center Crosshair
            ctx.strokeStyle = "rgba(255, 168, 1, 0.25)";
            ctx.lineWidth = 1;
            ctx.setLineDash([4, 4]);
            ctx.beginPath();
            ctx.moveTo(originX - 60, originY);
            ctx.lineTo(originX + 60, originY);
            ctx.moveTo(originX, originY - 60);
            ctx.lineTo(originX, originY + 60);
            ctx.stroke();
            ctx.setLineDash([]);

            // Draw Trail
            if (trail.length > 1) {
                for (let i = 1; i < trail.length; i++) {
                    const alpha = (i / trail.length) * 0.7;
                    ctx.strokeStyle = `rgba(255, 168, 1, ${alpha})`;
                    ctx.lineWidth = 2.5 * (i / trail.length);
                    ctx.beginPath();
                    ctx.moveTo(trail[i - 1].x, trail[i - 1].y);
                    ctx.lineTo(trail[i].x, trail[i].y);
                    ctx.stroke();
                }
            }

            // Draw Pointer Cursor
            ctx.save();
            ctx.translate(curX, curY);
            
            // Cursor Glow
            ctx.fillStyle = "rgba(255, 168, 1, 0.25)";
            ctx.beginPath();
            ctx.arc(0, 0, 16, 0, Math.PI * 2);
            ctx.fill();

            // Arrow shape
            ctx.fillStyle = "#ffa801";
            ctx.strokeStyle = "#ffffff";
            ctx.lineWidth = 1.5;
            ctx.beginPath();
            ctx.moveTo(0, 0);
            ctx.lineTo(16, 12);
            ctx.lineTo(9, 13);
            ctx.lineTo(14, 23);
            ctx.lineTo(10, 25);
            ctx.lineTo(5, 15);
            ctx.lineTo(0, 19);
            ctx.closePath();
            ctx.fill();
            ctx.stroke();
            ctx.restore();

            requestAnimationFrame(renderLoop);
        }

        requestAnimationFrame(renderLoop);
    </script>
</Layout>

<style>
    /* HERO SECTION */
    .hero-section {
        padding: 5.5rem 0 3.5rem;
        position: relative;
        overflow: hidden;
    }

    .hero-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .hero-icon-wrapper {
        position: relative;
        margin-bottom: 2rem;
    }

    .glow-ring {
        position: absolute;
        inset: -12px;
        border-radius: 36px;
        background: radial-gradient(circle, var(--primary-glow) 0%, transparent 70%);
        animation: pulseGlow 3s ease-in-out infinite alternate;
        z-index: 0;
    }

    @keyframes pulseGlow {
        from {
            transform: scale(0.95);
            opacity: 0.5;
        }
        to {
            transform: scale(1.08);
            opacity: 0.9;
        }
    }

    .hero-app-icon {
        position: relative;
        z-index: 1;
        border-radius: 28px;
        box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5), 0 0 20px var(--primary-glow);
        background: var(--bg-surface);
    }

    .hero-title {
        font-size: 3.5rem;
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.03em;
        margin-bottom: 1rem;
        max-width: 850px;
    }

    .gradient-text {
        background: linear-gradient(135deg, #ffa801 0%, #ffd32a 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .hero-tagline {
        font-size: 1.35rem;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 1rem;
        max-width: 720px;
    }

    .hero-description {
        font-size: 1.05rem;
        color: var(--text-muted);
        max-width: 680px;
        line-height: 1.7;
        margin-bottom: 2.5rem;
    }

    .hero-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 1.25rem;
        flex-wrap: wrap;
        margin-bottom: 3.5rem;
    }

    .play-badge-link {
        display: inline-block;
        transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), filter 0.25s ease;
        filter: drop-shadow(0 6px 18px var(--primary-glow));
        line-height: 0;
    }

    .play-badge-link:hover {
        transform: translateY(-3px) scale(1.03);
        filter: drop-shadow(0 10px 24px rgba(255, 168, 1, 0.4));
    }

    .play-badge-img {
        height: 64px;
        width: auto;
        display: block;
    }

    .btn-secondary-action {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        background: var(--bg-surface);
        color: var(--text-main);
        padding: 0.95rem 1.6rem;
        border-radius: var(--radius-md);
        border: 1px solid var(--border-subtle);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        transition: all 0.2s;
    }

    .btn-secondary-action:hover {
        border-color: var(--border-highlight);
        background: var(--bg-surface-elevated);
        transform: translateY(-2px);
    }

    /* Highlights Grid (3 items) */
    .highlights-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.5rem;
        width: 100%;
        max-width: 860px;
