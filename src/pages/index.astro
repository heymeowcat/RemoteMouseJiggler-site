---
import Layout from "../layouts/Layout.astro";
import AppPreview from "../components/AppPreview.astro";
import PlayBadge from "../components/PlayBadge.astro";
import { SITE } from "../data/site";
import { PATTERNS, FAQ } from "../data/content";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const title = "Remote Mouse Jiggler | Bluetooth Mouse, Keyboard & Jiggler for Android";
const description =
    "Turn an Android phone into a Bluetooth mouse, trackpad, keyboard and automated mouse jiggler. Eight movement patterns, a coding emulator, and no software to install on your computer.";

const facts = [
    {
        value: "0",
        label: "Installs on your computer",
        detail: "It is a standard Bluetooth HID device. Your operating system already knows what to do with one.",
    },
    {
        value: "8",
        label: "Jiggler movement patterns",
        detail: "From an invisible one pixel jitter to a coding emulator that types real lines of code.",
    },
    {
        value: "0",
        label: "Internet permission requests",
        detail: "The app cannot reach a server, so there is nothing to collect, log or sell.",
    },
];

const features = [
    {
        icon: "mouse",
        title: "Trackpad and air mouse",
        body: "Drag to move, tap once to left click, twice for right, three times for middle, and scroll with two fingers. Switch on the gyroscope and the phone becomes a pointer you move through the air.",
        points: ["One to three finger taps", "Two finger scrolling", "Gyroscope pointer"],
        linkText: "Explore the trackpad and air mouse",
        href: `${base}/features/#mouse`,
    },
    {
        icon: "keyboard",
        title: "Virtual keyboard",
        body: "Type a message and send it to your computer in one go, with or without a trailing Enter. Set the speed from 1 to 60 milliseconds per key and keep your copied indentation intact.",
        points: ["Send text or text and Enter", "1 to 60 ms per key", "Auto-indent compensation"],
        linkText: "Explore the virtual keyboard",
        href: `${base}/features/#keyboard`,
    },
    {
        icon: "jiggle",
        title: "Mouse jiggler",
        body: "Keep your session alive with eight movement patterns, adjustable interval and distance, and a timer that stops the run on its own. Start it from the app, a Quick Settings tile or a home screen widget.",
        points: ["Infinite or timed runs", "0.2 to 5 second interval", "Widget and tile control"],
        linkText: "Compare all eight jiggler patterns",
        href: `${base}/jiggler-patterns/`,
    },
    {
        icon: "shield",
        title: "Private by construction",
        body: "No account, no analytics, no advertising SDK, and no Android internet permission. Keystrokes and pointer positions live in memory for the length of a session and nowhere else.",
        points: ["No account required", "No telemetry", "Local only"],
        linkText: "Read how the privacy model works",
        href: `${base}/features/#privacy`,
    },
];

const steps = [
    {
        title: "Turn on Bluetooth",
        body: "Enable Bluetooth on your phone and on the machine you want to control: a Windows, macOS or Linux computer, an Android phone, an Android TV, or any other Bluetooth host.",
    },
    {
        title: "Find your device",
        body: "The app scans for classic Bluetooth and BLE devices together and shows real names, labelling computers, phones, TVs and audio hardware by their Bluetooth class.",
    },
    {
        title: "Pair from the remote side",
        body: "A normal Android pairing does not bind the HID profile, so the app guides you through pairing from the device you are controlling, then finishes the connection itself.",
    },
    {
        title: "Name it and go",
        body: "Rename the device so it shows up in your host's Bluetooth list under something recognisable. The new name applies immediately, with no restart.",
    },
];

const previewFaq = FAQ.slice(0, 4);

/* ------------------------------------------------------- structured data -- */

const graph = [
    {
        "@type": "WebSite",
        "@id": `${SITE.url}#website`,
        url: SITE.url,
        name: SITE.name,
        description,
        inLanguage: "en",
        publisher: { "@id": `${SITE.url}#publisher` },
    },
    {
        "@type": "Organization",
        "@id": `${SITE.url}#publisher`,
        name: SITE.developer,
        url: SITE.developerUrl,
        sameAs: [SITE.linkedinUrl],
    },
    {
        "@type": "SoftwareApplication",
        "@id": `${SITE.url}#app`,
        name: SITE.name,
        alternateName: "Remote Mouse Jiggler for Android",
        description,
        url: SITE.url,
        downloadUrl: SITE.playUrl,
        softwareVersion: SITE.version,
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Android 9.0 (API 28) and later",
        installUrl: SITE.playUrl,
        author: {
            "@type": "Person",
            name: SITE.developerName,
            url: SITE.developerUrl,
        },
        publisher: { "@id": `${SITE.url}#publisher` },
        offers: {
            "@type": "Offer",
            price: SITE.priceValue,
            priceCurrency: SITE.currency,
            availability: "https://schema.org/InStock",
        },
        featureList: [
            "Bluetooth HID mouse and trackpad",
            "Gyroscope air mouse",
            "Virtual keyboard with adjustable typing speed",
            "Eight mouse jiggler movement patterns",
            "Coding emulator jiggler pattern",
            "Quick Settings tile and home screen widget",
            "No internet permission",
        ],
    },
    {
        "@type": "FAQPage",
        "@id": `${SITE.url}#faq`,
        mainEntity: previewFaq.map((item) => ({
            "@type": "Question",
            name: item.q,
            acceptedAnswer: { "@type": "Answer", text: item.a },
        })),
    },
];
---

<Layout title={title} description={description} schema={graph}>
    <!-- ------------------------------------------------------------ hero -- -->
    <section class="hero">
        <div class="container hero__inner">
            <div class="hero__copy">
                <p class="eyebrow">Remote Mouse Jiggler for Android</p>
                <h1>
                    Your phone becomes a Bluetooth mouse, keyboard and mouse jiggler
                </h1>
                <p class="hero__lead">
                    Remote Mouse Jiggler turns your Android phone into a wireless
                    trackpad, an air mouse and a full keyboard for any computer or TV
                    that speaks Bluetooth HID — plus an automated mouse jiggler that
                    keeps your session alive. Nothing to install on the other machine,
                    and nothing leaves your phone.
                </p>

                <div class="btn-row hero__actions">
                    <PlayBadge size="lg" class="hero__badge" />
                    <a class="btn btn--ghost btn--lg" href={`${base}/download/`}>
                        See what is included
                    </a>
                </div>

                <p class="hero__meta">
                    Free · Android 9.0 and newer · No ads, no accounts, no tracking
                </p>
            </div>

            <div class="hero__art">
                <AppPreview />
            </div>
        </div>

        <!-- facts -->
        <div class="container">
            <dl class="facts">
                {
                    facts.map((fact) => (
                        <div class="facts__item">
                            <dt class="facts__value">{fact.value}</dt>
                            <dd>
                                <span class="facts__label">{fact.label}</span>
                                <span class="facts__detail">{fact.detail}</span>
                            </dd>
                        </div>
                    ))
                }
            </dl>
        </div>
    </section>

    <!-- -------------------------------------------------------- features -- -->
    <section class="section" id="features">
        <div class="container">
            <div class="section__head">
                <p class="eyebrow">What it does</p>
                <h2>One app, three ways to control your computer</h2>
                <p>
                    Every mode talks the same standard Bluetooth HID protocol, so your
                    computer sees one wireless keyboard and mouse no matter which mode
                    you are using.
                </p>
            </div>

            <div class="grid grid--2 feature-grid">
                {
                    features.map((feature) => (
                        <article class="card card--pad feature">
                            <span class="feature__icon" aria-hidden="true">
                                {feature.icon === "mouse" && (
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="6" y="2.5" width="12" height="19" rx="6" />
                                        <path d="M12 6.5v3.5" />
                                    </svg>
                                )}
                                {feature.icon === "keyboard" && (
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="2.5" y="5.5" width="19" height="13" rx="2.5" />
                                        <path d="M6 9.5h.01M9.5 9.5h.01M13 9.5h.01M16.5 9.5h.01M6 12.5h.01M9.5 12.5h.01M13 12.5h.01M16.5 12.5h.01M8 15.5h8" />
                                    </svg>
                                )}
                                {feature.icon === "jiggle" && (
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 2.5v3M12 18.5v3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M2.5 12h3M18.5 12h3M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1" />
                                        <circle cx="12" cy="12" r="3.4" />
                                    </svg>
                                )}
                                {feature.icon === "shield" && (
                                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M12 2.5 4.5 5.6v6c0 4.4 3.1 8.4 7.5 9.9 4.4-1.5 7.5-5.5 7.5-9.9v-6z" />
                                        <path d="m9 11.8 2.2 2.2 4-4.2" />
                                    </svg>
                                )}
                            </span>
                            <h3 class="feature__title">{feature.title}</h3>
                            <p class="feature__body">{feature.body}</p>
                            <ul class="feature__points">
                                {feature.points.map((point) => (
                                    <li>{point}</li>
                                ))}
                            </ul>
                            <a class="feature__link" href={feature.href}>
                                {feature.linkText}
                                <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M5 12h13M13 6l6 6-6 6" />
                                </svg>
                            </a>
                        </article>
                    ))
                }
            </div>
        </div>
    </section>

    <!-- -------------------------------------------------------- patterns -- -->
    <section class="section section--tint" id="patterns">
        <div class="container">
            <div class="section__head">
                <p class="eyebrow">The jiggler</p>
                <h2>Eight ways to keep a session alive</h2>
                <p>
                    Each pattern is a different movement profile, all generated on
                    device and all sent as genuine relative mouse input. Set the
                    interval from 0.2 to 5 seconds and the distance from 2 to 50
                    pixels.
                </p>
            </div>

            <ul class="pattern-grid">
                {
                    PATTERNS.map((pattern) => (
                        <li class="pattern">
                            <div class="pattern__head">
                                <h3 class="pattern__name">{pattern.name}</h3>
                                <span
                                    class:list={[
                                        "chip",
                                        pattern.tag === "Signature"
                                            ? "chip--accent"
                                            : pattern.tag === "Screen saver"
                                              ? "chip--ok"
                                              : "chip--brand",
                                    ]}
                                >
                                    {pattern.tag}
                                </span>
                            </div>
                            <p class="pattern__short">{pattern.short}</p>
                        </li>
                    ))
                }
            </ul>

            <div class="section__cta">
                <a class="btn btn--primary" href={`${base}/jiggler-patterns/`}>
                    Compare all eight patterns
                </a>
            </div>
        </div>
    </section>

    <!-- ----------------------------------------------------------- setup -- -->
    <section class="section" id="how-it-works">
        <div class="container">
            <div class="section__head">
                <p class="eyebrow">Getting started</p>
                <h2>Pair it in a couple of minutes</h2>
                <p>
                    The whole setup happens over the Bluetooth link between your
                    phone and the machine in front of you.
                </p>
            </div>

            <ol class="steps">
                {
                    steps.map((step, index) => (
                        <li class="step">
                            <span class="step__number" aria-hidden="true">
                                {index + 1}
                            </span>
                            <h3 class="step__title">{step.title}</h3>
                            <p class="step__body">{step.body}</p>
                        </li>
                    ))
                }
            </ol>
        </div>
    </section>

    <!-- --------------------------------------------------------- faq ---- -->
    <section class="section section--tint" id="faq">
        <div class="container">
            <div class="section__head">
                <p class="eyebrow">Questions</p>
                <h2>Straight answers</h2>
                <p>
                    The full list lives on the
                    <a href={`${base}/faq/`}>FAQ page</a>.
                </p>
            </div>

            <div class="grid grid--2">
                {
                    previewFaq.map((item) => (
                        <article class="card">
                            <h3 class="card__title">{item.q}</h3>
                            <p class="card__body">{item.a}</p>
                        </article>
                    ))
                }
            </div>

            <div class="section__cta">
                <a class="btn btn--ghost" href={`${base}/faq/`}>See every question</a>
            </div>
        </div>
    </section>

    <!-- ----------------------------------------------------------- cta -- -->
    <section class="section">
        <div class="container">
            <div class="cta">
                <div class="cta__copy">
                    <h2>Put your phone to work as a mouse</h2>
                    <p>
                        Free to download, with no account and no ads. Install it,
                        pair it once, and never be locked out of a session again.
                    </p>
                </div>
                <div class="btn-row cta__actions">
                    <a
                        class="btn btn--accent btn--lg"
                        href={SITE.playUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        Get it on Google Play
                    </a>
                    <a class="btn btn--ghost btn--lg" href={`${base}/download/`}>
                        Download details
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>

<style>
    /* ------------------------------------------------------------- hero -- */
    .hero {
        padding-block: clamp(2.5rem, 1.5rem + 5vw, 5rem) clamp(2rem, 1rem + 3vw, 3rem);
        background:
            radial-gradient(
                60rem 30rem at 15% -10%,
                color-mix(in srgb, var(--brand) 12%, transparent),
                transparent 70%
            ),
            radial-gradient(
                40rem 24rem at 95% 0%,
                color-mix(in srgb, var(--accent) 10%, transparent),
                transparent 65%
            );
    }

    .hero__inner {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
        align-items: center;
    }

    .hero__lead {
        margin-top: 1.1rem;
        font-size: 1.09rem;
        color: var(--ink-2);
        max-width: 56ch;
    }

    .hero__actions {
        margin-top: 1.75rem;
    }

    .hero__meta {
        margin-top: 1rem;
        font-size: 0.85rem;
        color: var(--ink-3);
    }

    .hero__art-panel {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-xl);
        padding: 1.75rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.25rem;
        box-shadow: var(--shadow-md);
    }

    .hero__badge {
        align-self: flex-start;
    }

    /* ------------------------------------------------------------ facts -- */
    .facts {
        margin: clamp(2.5rem, 1.5rem + 3vw, 4rem) 0 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
        gap: 1rem;
        border-top: 1px solid var(--line);
        padding-top: 1.75rem;
    }

    .facts__item {
        display: flex;
        gap: 0.9rem;
        align-items: flex-start;
    }

    .facts__value {
        font-size: 2.1rem;
        font-weight: 800;
        line-height: 1;
        letter-spacing: -0.04em;
        color: var(--brand);
        flex: none;
        min-width: 2.2ch;
    }

    .facts__label {
        display: block;
        font-weight: 650;
        font-size: 0.95rem;
    }

    .facts__detail {
        display: block;
        font-size: 0.86rem;
        color: var(--ink-3);
        line-height: 1.5;
    }

    /* --------------------------------------------------------- feature -- */
    .feature {
        display: flex;
        flex-direction: column;
    }

    .feature__icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: var(--r-md);
        background: var(--brand-soft);
        color: var(--brand);
        margin-bottom: 1rem;
        flex: none;
    }

    .feature__title {
        margin-bottom: 0.5rem;
    }

    .feature__body {
        color: var(--ink-2);
        font-size: 0.95rem;
        margin-bottom: 1rem;
    }

    .feature__points {
        list-style: none;
        margin: 0 0 1.1rem;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem;
    }

    .feature__points li {
        font-size: 0.76rem;
        font-weight: 600;
        color: var(--ink-2);
        background: var(--surface-2);
        border: 1px solid var(--line);
        border-radius: var(--r-pill);
        padding: 0.2rem 0.65rem;
    }

    .feature__link {
        margin-top: auto;
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.9rem;
        font-weight: 650;
        text-decoration: none;
        color: var(--brand);
    }

    .feature__link:hover {
        text-decoration: underline;
    }

    .feature__link svg {
        transition: transform 0.16s ease;
    }

    .feature__link:hover svg {
        transform: translateX(3px);
    }

    /* --------------------------------------------------------- pattern -- */
    .pattern-grid {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
        gap: 1rem;
    }

    .pattern {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        padding: 1.15rem 1.25rem;
    }

    .pattern__head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 0.75rem;
        margin-bottom: 0.4rem;
    }

    .pattern__name {
        font-size: 1rem;
        font-weight: 700;
    }

    .pattern__short {
        font-size: 0.9rem;
        color: var(--ink-2);
        line-height: 1.55;
    }

    .section__cta {
        margin-top: 2rem;
        text-align: center;
    }

    /* ----------------------------------------------------------- steps -- */
    .steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
        gap: 1.25rem;
        counter-reset: step;
    }

    .step {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        padding: 1.5rem;
    }

    .step__number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        background: var(--brand);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 0.85rem;
        flex: none;
    }

    .step__title {
        font-size: 1.05rem;
        margin-bottom: 0.4rem;
    }

    .step__body {
        font-size: 0.92rem;
        color: var(--ink-2);
        line-height: 1.6;
    }

    /* ------------------------------------------------------------- cta -- */
    .cta {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-xl);
        padding: clamp(1.75rem, 1.25rem + 2.5vw, 3rem);
        display: grid;
        gap: 1.5rem;
        align-items: center;
        box-shadow: var(--shadow-md);
    }

    .cta__copy p {
        margin-top: 0.6rem;
        color: var(--ink-2);
        max-width: 52ch;
    }

    @media (min-width: 60rem) {
        .hero__inner {
            grid-template-columns: minmax(0, 1fr) minmax(0, 20rem);
            gap: 3.5rem;
        }

        .hero__art {
            justify-self: center;
            width: 100%;
        }

        .cta {
            grid-template-columns: minmax(0, 1.4fr) auto;
        }

        .cta__actions {
            justify-content: flex-end;
        }
    }
</style>
