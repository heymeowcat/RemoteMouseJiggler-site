---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import { SITE } from "../data/site";
import { PAIRING_STEPS, BLUETOOTH_FACTS } from "../data/content";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const title = "How it works";
const description =
    "How Remote Mouse Jiggler turns an Android phone into a Bluetooth HID keyboard and mouse: the report descriptor, the report formats, the pairing flow and the hosts it supports.";

const hosts = [
    { name: "Windows", detail: "Bluetooth settings, Devices and Printers" },
    { name: "macOS", detail: "System Settings, Bluetooth" },
    { name: "Linux", detail: "BlueZ through the standard desktop settings" },
    { name: "ChromeOS", detail: "Bluetooth settings" },
    { name: "Android TV", detail: "Pairing from the TV's Bluetooth menu" },
    { name: "Android phone", detail: "Bluetooth settings" },
];

const permissions = [
    {
        name: "BLUETOOTH_CONNECT",
        purpose: "Connect to the paired computer, TV or receiver over Bluetooth HID.",
    },
    {
        name: "BLUETOOTH_SCAN",
        purpose:
            "Discover nearby Bluetooth devices to pair with. Declared with the neverForLocation flag, so it cannot be used to derive your physical location.",
    },
    {
        name: "FOREGROUND_SERVICE_CONNECTED_DEVICE",
        purpose:
            "Keep the HID connection alive while you use other apps, so the jiggler and the pointer keep working in the background.",
    },
    {
        name: "POST_NOTIFICATIONS",
        purpose: "Show the ongoing connection notification and the Quick Settings tile.",
    },
    {
        name: "RECEIVE_BOOT_COMPLETED",
        purpose:
            "Restart the connection automatically after a reboot when you have chosen an auto-connect device.",
    },
    {
        name: "BLUETOOTH, BLUETOOTH_ADMIN, ACCESS_FINE_LOCATION, ACCESS_COARSE_LOCATION",
        purpose:
            "Requested only on Android 10 and older, where the modern Bluetooth permissions do not exist.",
    },
];

const schema = [
    {
        "@type": "BreadcrumbList",
        "@id": `${SITE.url}bluetooth-hid/#breadcrumb`,
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Home",
                item: SITE.url,
            },
            {
                "@type": "ListItem",
                position: 2,
                name: "How it works",
                item: `${SITE.url}bluetooth-hid/`,
            },
        ],
    },
    {
        "@type": "TechArticle",
        "@id": `${SITE.url}bluetooth-hid/#article`,
        headline: title,
        description,
        url: `${SITE.url}bluetooth-hid/`,
        inLanguage: "en",
        isPartOf: { "@id": `${SITE.url}#website` },
        breadcrumb: { "@id": `${SITE.url}bluetooth-hid/#breadcrumb` },
        author: {
            "@type": "Person",
            name: SITE.developerName,
            url: SITE.developerUrl,
        },
        publisher: { "@id": `${SITE.url}#publisher` },
        about: { "@id": `${SITE.url}#app` },
    },
];
---

<Layout title={title} description={description} titleSuffix={title} schema={schema}>
    <PageHero
        eyebrow="Under the hood"
        title="How a phone becomes a Bluetooth mouse"
        lead="Remote Mouse Jiggler implements the Bluetooth Human Interface Device profile directly. That is why your computer needs nothing installed, and why it works the same on Windows, macOS, Linux, ChromeOS and Android TV."
    />

    <div class="container page">
        <!-- ------------------------------------------------------ what -- -->
        <section class="block">
            <h2>What the host actually sees</h2>
            <div class="prose">
                <p>
                    When the app pairs, the host creates a standard Bluetooth HID
                    device. It appears in the Bluetooth list with a name you choose
                    in the app, and it behaves exactly like a wireless keyboard and
                    mouse bought from a shop. The host's own driver stack parses the
                    reports and moves the pointer or types the character. Nothing
                    is left for the app to do afterwards.
                </p>
                <p>
                    That is the whole trick: rather than pretending to be a mouse
                    with a background service on the computer, the app is a mouse.
                </p>
            </div>

            <div class="grid grid--2 block__grid">
                {
                    BLUETOOTH_FACTS.map((fact) => (
                        <article class="card">
                            <h3 class="card__title">{fact.title}</h3>
                            <p class="card__body">{fact.body}</p>
                        </article>
                    ))
                }
            </div>
        </section>

        <!-- ------------------------------------------------------ pair -- -->
        <section class="block">
            <h2>Pairing</h2>
            <div class="prose">
                <p>
                    Pairing a Bluetooth HID device from Android takes two steps
                    rather than one, and the reason is worth understanding. The
                    usual Android Bluetooth pairing creates a bonded connection
                    between the two devices. A HID device needs that bond
                    <em>plus</em> a separate HID profile connection layered on top
                    of it, and the HID part has to be established from the host
                    side.
                </p>
                <p>
                    The app handles both halves. It scans on your phone, and it
                    includes a step by step guide for completing the pairing from
                    the machine you are controlling.
                </p>
            </div>

            <ol class="steps">
                {
                    PAIRING_STEPS.map((step, index) => (
                        <li class="step">
                            <span class="step__number" aria-hidden="true">
                                {index + 1}
                            </span>
                            <h3 class="step__title">{step.title}</h3>
                            <p class="step__body">{step.body}</p>
                        </li>
                    ))
                }
            </ol>

            <h3>Supported hosts</h3>
            <div class="table-wrap">
                <table>
                    <caption class="visually-hidden">
                        Hosts that accept a Bluetooth HID keyboard and mouse
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">Host</th>
                            <th scope="col">Where to pair</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            hosts.map((host) => (
                                <tr>
                                    <th scope="row">{host.name}</th>
                                    <td>{host.detail}</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>
        </section>

        <!-- ------------------------------------------------------ scan -- -->
        <section class="block">
            <h2>Finding your device</h2>
            <div class="prose">
                <p>
                    The scan runs classic Bluetooth discovery and a BLE scan at the
                    same time. Devices found over BLE are used to resolve the names
                    of their classic counterparts, so the list shows what a device
                    is actually called rather than a generic fallback.
                </p>
                <p>
                    Devices are grouped by their Bluetooth class, which is how
                    computers, phones, TVs, audio hardware, printers, network gear
                    and wearables are labelled in the list. If a device has no
                    usable name it is skipped rather than shown as a blank row.
                </p>
                <p>
                    You can also type a Bluetooth address by hand, which is useful
                    for devices that do not show up in a scan.
                </p>
            </div>
        </section>

        <!-- ----------------------------------------------- permissions -- -->
        <section class="block">
            <h2>Permissions</h2>
            <div class="prose">
                <p>
                    The app requests the minimum it needs, and nothing else. There
                    is no internet permission, no location permission on modern
                    Android, and no storage or contacts access.
                </p>
            </div>

            <div class="table-wrap">
                <table>
                    <caption class="visually-hidden">
                        Android permissions requested by the app and their purpose
                    </caption>
                    <thead>
                        <tr>
                            <th scope="col">Permission</th>
                            <th scope="col">Purpose</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            permissions.map((permission) => (
                                <tr>
                                    <th scope="row">
                                        <code>{permission.name}</code>
                                    </th>
                                    <td>{permission.purpose}</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            <p class="block__note">
                The full list, with the reasoning behind each one, is in the
                <a href={`${base}/privacy/`}>privacy policy</a>.
            </p>
        </section>

        <!-- -------------------------------------------------- stability -- -->
        <section class="block">
            <h2>Staying connected</h2>
            <div class="prose">
                <p>
                    A Bluetooth HID link that has been open for six hours behaves
                    differently from one that was opened a minute ago. The app
                    therefore treats long sessions as a first class case:
                </p>
            </div>

            <ul class="ticks">
                <li>
                    <strong>Hourly refresh.</strong> Every 60 minutes the app
                    releases all keys, drops the HID link for five seconds and
                    reconnects. Nothing flashes on screen while it happens.
                </li>
                <li>
                    <strong>No stuck keys.</strong> Every key press is followed by
                    a release, and all keys are released when the connection drops
                    or a run stops.
                </li>
                <li>
                    <strong>Ordered dispatch.</strong> Key presses and pasted text
                    go through a single queue, so a long paste can never interleave
                    with a stray key. Mouse movement uses a separate coalescing
                    queue, so intermediate drag positions are dropped rather than
                    queued up behind each other.
                </li>
                <li>
                    <strong>Foreground service.</strong> A low-priority ongoing
                    notification keeps the connection alive while you use other
                    apps, and shows which device is connected.
                </li>
                <li>
                    <strong>Reconnect after reboot.</strong> If you have chosen an
                    auto-connect device, the app starts the service after a restart
                    and reconnects on its own.
                </li>
            </ul>
        </section>

        <!-- ------------------------------------------------------- cta -- -->
        <div class="cta">
            <div class="cta__copy">
                <h2>See it on your own machine</h2>
                <p>
                    Pair once and the phone becomes a mouse, a keyboard and a
                    jiggler for any HID host.
                </p>
            </div>
            <div class="btn-row cta__actions">
                <a
                    class="btn btn--primary"
                    href={SITE.playUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    Get it on Google Play
                </a>
                <a class="btn btn--ghost" href={`${base}/features/`}>
                    See all features
                </a>
            </div>
        </div>
    </div>
</Layout>

<style>
    .page {
        padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    }

    .block + .block {
        margin-top: 3.5rem;
        padding-top: 3.5rem;
        border-top: 1px solid var(--line);
    }

    .block__grid {
        margin-top: 1.5rem;
    }

    .block h3 {
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }

    .block__note {
        margin-top: 1.5rem;
        padding: 1rem 1.15rem;
        border-radius: var(--r-md);
        background: var(--brand-soft-2);
        border: 1px solid var(--line);
        font-size: 0.92rem;
        color: var(--ink-2);
    }

    .steps {
        list-style: none;
        margin: 1.5rem 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr));
        gap: 1.25rem;
    }

    .step {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        padding: 1.5rem;
    }

    .step__number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        background: var(--brand);
        color: #fff;
        font-size: 0.85rem;
        font-weight: 700;
        margin-bottom: 0.85rem;
        flex: none;
    }

    .step__title {
        font-size: 1.05rem;
        margin-bottom: 0.4rem;
    }

    .step__body {
        font-size: 0.92rem;
        color: var(--ink-2);
        line-height: 1.6;
    }

    .ticks {
        list-style: none;
        margin: 1.25rem 0 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.7rem;
        max-width: var(--prose);
    }

    .ticks li {
        position: relative;
        padding-left: 1.6rem;
        color: var(--ink-2);
        font-size: 0.95rem;
    }

    .ticks li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--brand);
        transform: translateY(-50%);
    }

    .ticks strong {
        color: var(--ink);
    }

    .cta {
        margin-top: 3.5rem;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-xl);
        padding: clamp(1.5rem, 1.25rem + 1.5vw, 2.25rem);
        display: grid;
        gap: 1.25rem;
        align-items: center;
    }

    .cta__copy p {
        margin-top: 0.5rem;
        color: var(--ink-2);
    }

    @media (min-width: 62rem) {
        .cta {
            grid-template-columns: minmax(0, 1fr) auto;
        }
    }
</style>
