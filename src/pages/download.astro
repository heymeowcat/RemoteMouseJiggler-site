---
import Layout from "../layouts/Layout.astro";
import PageHero from "../components/PageHero.astro";
import Brand from "../components/Brand.astro";
import PlayBadge from "../components/PlayBadge.astro";
import { SITE } from "../data/site";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const title = "Download";
const description =
    "Download Remote Mouse Jiggler for Android free from Google Play. Turn your phone into a Bluetooth mouse, keyboard and automated mouse jiggler. No account, no ads, no internet permission.";

const requirements = [
    { label: "Android version", value: "Android 9.0 (API 28) or newer" },
    { label: "Bluetooth", value: "Classic Bluetooth HID or BLE host" },
    { label: "Price", value: "Free" },
    { label: "Account", value: "Not required" },
    { label: "Ads", value: "None" },
    { label: "Internet permission", value: "Not requested" },
];

const included = [
    "Bluetooth HID touchpad with left, middle and right clicks",
    "Gyroscope air mouse with rotation aware axes",
    "Virtual keyboard with 1 to 60 ms typing speed",
    "Eight mouse jiggler patterns including the coding emulator",
    "Quick Settings tile and home screen widget",
    "Boot-time reconnection and an hourly link refresh",
    "Light, dark and true black themes",
];

const steps = [
    {
        title: "Install from Google Play",
        body: "Open the listing on your phone and tap install. The app is small and needs no special access beyond Bluetooth.",
    },
    {
        title: "Turn on Bluetooth",
        body: "Enable Bluetooth on your phone and on the computer, TV or other device you want to control.",
    },
    {
        title: "Scan and pair",
        body: "Open the app, scan for your device and select it. Follow the pairing steps from the remote side if prompted.",
    },
    {
        title: "Start using it",
        body: "Move your finger across the trackpad, tap to click, or start the jiggler from the app, the Quick Settings tile or the widget.",
    },
];

const schema = [
    {
        "@type": "BreadcrumbList",
        "@id": `${SITE.url}download/#breadcrumb`,
        itemListElement: [
            {
                "@type": "ListItem",
                position: 1,
                name: "Home",
                item: SITE.url,
            },
            {
                "@type": "ListItem",
                position: 2,
                name: "Download",
                item: `${SITE.url}download/`,
            },
        ],
    },
    {
        "@type": "SoftwareApplication",
        "@id": `${SITE.url}download/#app`,
        name: SITE.name,
        description,
        url: `${SITE.url}download/`,
        downloadUrl: SITE.playUrl,
        installUrl: SITE.playUrl,
        softwareVersion: SITE.version,
        applicationCategory: "UtilitiesApplication",
        operatingSystem: "Android 9.0 (API 28) and later",
        author: {
            "@type": "Person",
            name: SITE.developerName,
            url: SITE.developerUrl,
        },
        publisher: { "@id": `${SITE.url}#publisher` },
        offers: {
            "@type": "Offer",
            price: SITE.priceValue,
            priceCurrency: SITE.currency,
            availability: "https://schema.org/InStock",
            url: SITE.playUrl,
        },
        featureList: included,
    },
];
---

<Layout title={title} description={description} titleSuffix={title} schema={schema}>
    <PageHero
        eyebrow="Get the app"
        title="Download Remote Mouse Jiggler"
        lead="Free on Google Play, with no account, no ads and no internet permission. The only thing it asks for is Bluetooth."
    >
        <div class="download-card">
            <Brand
                size={88}
                class="download-card__icon"
                alt="Remote Mouse Jiggler app icon: a yellow duck on a blue background"
                loading="eager"
                fetchpriority="high"
            />
            <div class="download-card__body">
                <p class="download-card__name">Remote Mouse Jiggler</p>
                <p class="download-card__meta">
                    Version {SITE.version} · {SITE.minSdk} · Free
                </p>
                <PlayBadge size="lg" class="download-card__cta" />
                <p class="download-card__note">
                    Package <code>{SITE.packageName}</code>
                </p>
            </div>
        </div>
    </PageHero>

    <div class="container page">
        <div class="two-col">
            <!-- ---------------------------------------------------- req -- -->
            <section class="block">
                <h2>What you need</h2>
                <div class="table-wrap">
                    <table>
                        <caption class="visually-hidden">
                            Requirements and pricing for Remote Mouse Jiggler
                        </caption>
                        <tbody>
                            {
                                requirements.map((row) => (
                                    <tr>
                                        <th scope="row">{row.label}</th>
                                        <td>{row.value}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>

                <h3>What is included</h3>
                <ul class="ticks">
                    {
                        included.map((item) => (
                            <li>{item}</li>
                        ))
                    }
                </ul>
            </section>

            <!-- -------------------------------------------------- steps -- -->
            <section class="block">
                <h2>Installing it</h2>
                <ol class="steps">
                    {
                        steps.map((step, index) => (
                            <li class="step">
                                <span class="step__number" aria-hidden="true">
                                    {index + 1}
                                </span>
                                <h3 class="step__title">{step.title}</h3>
                                <p class="step__body">{step.body}</p>
                            </li>
                        ))
                    }
                </ol>

                <h3>What happens after you install</h3>
                <p class="note">
                    The app asks for Bluetooth permission the first time you open
                    it, then for notification permission so the connection can stay
                    alive in the background. It never asks for anything else, and it
                    never asks for the internet.
                </p>
                <a
                    class="btn btn--ghost"
                    href={`${base}/faq/`}
                >
                    Read the setup questions
                </a>
            </section>
        </div>

        <div class="cta">
            <div class="cta__copy">
                <h2>Questions before you install?</h2>
                <p>
                    The <a href={`${base}/faq/`}>FAQ</a> covers pairing, privacy and
                    what the jiggler actually sends, and
                    <a href={`${base}/bluetooth-hid/`}>how it works</a> explains the
                    protocol in detail.
                </p>
            </div>
            <div class="btn-row cta__actions">
                <a class="btn btn--ghost" href={`${base}/faq/`}>Read the FAQ</a>
            </div>
        </div>
    </div>
</Layout>

<style>
    .download-card {
        margin-top: 2rem;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 1.5rem;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-xl);
        padding: 1.5rem;
        box-shadow: var(--shadow-md);
        max-width: 34rem;
    }

    .download-card__icon {
        border-radius: 20px;
        flex: none;
    }

    .download-card__name {
        font-weight: 700;
        font-size: 1.15rem;
        letter-spacing: -0.015em;
    }

    .download-card__meta {
        font-size: 0.87rem;
        color: var(--ink-3);
        margin-bottom: 0.9rem;
    }

    .download-card__note {
        margin-top: 0.7rem;
        font-size: 0.78rem;
        color: var(--ink-3);
    }

    .page {
        padding-block: clamp(2rem, 1.5rem + 2vw, 3.25rem);
    }

    .two-col {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 2.5rem;
    }

    .block h3 {
        margin-top: 2rem;
        margin-bottom: 0.75rem;
    }

    .note {
        color: var(--ink-2);
        font-size: 0.94rem;
        margin-bottom: 1rem;
        max-width: var(--prose);
    }

    .ticks {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .ticks li {
        position: relative;
        padding-left: 1.6rem;
        color: var(--ink-2);
        font-size: 0.94rem;
    }

    .ticks li::before {
        content: "";
        position: absolute;
        left: 0;
        top: 0.55em;
        width: 0.5rem;
        height: 0.5rem;
        border-radius: 50%;
        background: var(--brand);
        transform: translateY(-50%);
    }

    .steps {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .step {
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-lg);
        padding: 1.25rem 1.4rem;
    }

    .step__number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1.85rem;
        height: 1.85rem;
        border-radius: 50%;
        background: var(--brand);
        color: var(--on-brand);
        font-size: 0.8rem;
        font-weight: 700;
        margin-bottom: 0.7rem;
        flex: none;
    }

    .step__title {
        font-size: 1rem;
        margin-bottom: 0.3rem;
    }

    .step__body {
        font-size: 0.92rem;
        color: var(--ink-2);
        line-height: 1.6;
    }

    .cta {
        margin-top: 3.5rem;
        background: var(--surface);
        border: 1px solid var(--line);
        border-radius: var(--r-xl);
        padding: clamp(1.5rem, 1.25rem + 1.5vw, 2.25rem);
        display: grid;
        gap: 1.25rem;
        align-items: center;
    }

    .cta__copy p {
        margin-top: 0.5rem;
        color: var(--ink-2);
        max-width: 60ch;
    }

    @media (min-width: 62rem) {
        .two-col {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 3.5rem;
        }

        .cta {
            grid-template-columns: minmax(0, 1fr) auto;
        }
    }
</style>
